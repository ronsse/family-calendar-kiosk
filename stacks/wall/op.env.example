# Copy to `op.env` (gitignored) and run the stack through 1Password:
#
#   op run --env-file=op.env -- docker compose up -d --build
#
# These are REFERENCES, not values. `op run` resolves them from a 1Password service
# account at launch and puts the real values only in the environment of the compose process.
# Never paste a token into this file, or into docker-compose.yml, or into kiosk.env on the Pi.
#
# The file is named op.env rather than .env on purpose: compose auto-loads `./.env`, so a
# forgotten `op run` would silently interpolate the literal string "op://..." as the token —
# a calendar that never syncs and says nothing useful about why.

# Home Assistant remains the calendar integration layer (ADR-0001). Origin only, no path.
# Hostname, never an IP: a DHCP LAN address drifts.
HA_BASE_URL=http://homeserver:8123
HA_TOKEN=op://<vault>/<item>/<field>

# Both may be omitted entirely. The app then runs chores and routines with no upstream
# calendar and logs that it declined to schedule a sync — which is the honest presentation of
# "no calendar configured", as opposed to an empty week that looks like a quiet one.

# iCal adapter: read each Google calendar's "secret address in iCal format" directly instead of
# through Home Assistant's OAuth. Set WALL_CALENDAR_SOURCE=ics and one ICS_URL_* per calendar,
# named from its calendar_source.external_ref (calendar.school -> ICS_URL_CALENDAR_SCHOOL).
# The addresses are credentials — anyone holding one reads that calendar — so op:// only.
#WALL_CALENDAR_SOURCE=ics
#ICS_URL_CALENDAR_FAMILY=op://<vault>/<item>/family
#ICS_URL_CALENDAR_SCHOOL=op://<vault>/<item>/school
