[Unit]
Description=family-calendar — scene generation (Sunday and Wednesday nights)

[Timer]
# Sunday and Wednesday 02:30, in the HOUSEHOLD's zone: install.sh appends `timezone` from
# db/household.json to the installed copy of this line, because the server runs UTC and 02:30
# UTC is the previous evening in America. Sunday's run (`2026-W43`) is the picture for Sun..Tue,
# Wednesday's (`2026-W43b`) for Wed..Sat. Both are far from the 06:00 school-day window this
# project's prime invariant is about — a generation run must never share a minute with the
# wall's busiest read.
OnCalendar=Sun,Wed *-*-* 02:30:00
# The box is not always on. Without this, a Sunday spent powered down silently skips the week,
# and the symptom is exactly the one that started all of this: "the image never updates."
Persistent=true
# It talks to a paid API on a schedule everyone can predict. Spread it out.
RandomizedDelaySec=30min

[Install]
WantedBy=timers.target
