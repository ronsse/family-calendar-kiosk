[Unit]
# The weekly picture. See tools/scene-week.py — it GENERATES and OFFERS; it never changes
# what is on the wall. A failure here means the wall keeps last week's picture, which is why
# this is safe to run unattended at all.
Description=family-calendar — generate this week's scene as a candidate
Documentation=file://%h/projects/family-calendar/docs/runbook.md
# Nothing here blocks the wall, so it waits for the network rather than for the wall itself.
After=network-online.target
Wants=network-online.target
# Up to four retries (see Restart= below), then it stays failed until next Sunday. The window
# is wider than four RestartSec gaps so the limit is the burst, never the clock.
StartLimitIntervalSec=6h
StartLimitBurst=5

[Service]
Type=oneshot
WorkingDirectory=%h/projects/family-calendar
# The service-account token is NOT in the environment of a systemd unit — .bashrc is an
# interactive-login thing and this is not one. Same trap as an agent shell (CLAUDE.md), and it
# presents identically: `op` fails with "no account found", which reads like a broken secret
# rather than an unset variable.
Environment=OP_SERVICE_ACCOUNT_TOKEN_FILE=%h/.config/op-service-token
# The API keys arrive as environment variables from `op run --env-file=tools/op.env` (gitignored,
# references only; tools/op.env.example is the template); scene-week.py names no vault. The
# wrapper exists because `op run` exits 1 when it cannot reach 1Password, and 1 is the finder's
# REFUSAL below, which is never retried: straight through, the 2026-09-27 DNS blip would have
# read as a verdict. tools/scene-week-timer.sh reports any failure of op itself as 2.
ExecStart=/usr/bin/env bash -lc 'exec bash tools/scene-week-timer.sh'
# Two images and four vision passes, each a minute or two on fal. Anything past this is a hung
# endpoint, not slow work — NVIDIA's free image path hung for 90s at a stretch on 2026-09-08,
# and an un-timed unit would sit there.
TimeoutStartSec=20min
# A NETWORK BLIP USED TO COST THE WHOLE WEEK (2026-09-27). DNS on the server answered "server
# misbehaving" at 02:54, `op read` could not reach 1Password, scene-week exited 2 before
# spending anything — and nothing ran again until the next Sunday, so the wall kept the old
# picture for seven days and nobody was told.
#
# Exit 2 is "errored, never judged", and a re-run of it is cheap by design: the images are
# kept in /tmp/scene-week and reused, so a retry costs a vision pass at most. Exit 1 is the
# finder REFUSING both pictures — a verdict, not a fault — and retrying it would only pay for
# the same answer again, so it is excluded. Exit 3 is OVER BUDGET (scenes.weeklyBudgetUsd in
# db/household.json): the ledger will not shrink in thirty minutes, so a retry is the same answer
# too. Both are reported in the journal and wait for a person.
Restart=on-failure
RestartSec=30min
RestartPreventExitStatus=1 3
# It must never be a reason the wall is down; nothing depends on it succeeding.
Nice=10
