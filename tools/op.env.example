# The scene tools' API keys, as 1Password references. Copy to tools/op.env (gitignored) and
# replace <vault> and <item> with your own; the file holds references only, never a secret.
#
#   op run --env-file=tools/op.env -- python3 tools/scene-week.py --dry-run
#   tools/scene-week-timer.sh            # what the Sunday timer runs
#
# FAL_KEY draws the pictures and runs the finder (the default provider). NOUS_API_KEY and
# NVIDIA_API_KEY are needed only for `--provider nous` / `--provider nvidia`; leave a line out
# and that provider will say which variable is not set.
FAL_KEY=op://<vault>/<item>/credential
NOUS_API_KEY=op://<vault>/<item>/credential
NVIDIA_API_KEY=op://<vault>/<item>/credential
