# Kiosk configuration. Read by kiosk.service and kiosk-gate.service via EnvironmentFile.
# Plain KEY=VALUE only — no export, no quotes-with-expansion, no command substitution.

# What the wall shows: the family-calendar app itself (ADR-0004), served from homeserver by the
# stack in stacks/wall/. It serves BOTH the API and the React bundle from one origin, so this
# is the whole URL — there is no separate frontend host and no dashboard path to get wrong.
#
# Hostname, never an IP: homeserver's LAN address has already drifted once. Note the
# Pi cannot currently resolve `homeserver` (ROADMAP M0) — fix that by NAME, via tailnet MagicDNS
# or a router-served lease, not by pinning an address here.
#
# This replaced http://homeserver:8123/wall-display/today, which was Home Assistant's Lovelace
# view. HA is still the calendar integration layer; it is no longer what the wall renders.
DASHBOARD_URL=http://homeserver:8124/

# How this panel proves it is this panel. `/api/wall/*` requires `Authorization: Device
# <token>`; the token is issued ONCE on homeserver and lives here, on the Pi.
#
#   on homeserver:  npm run provision -- --device "living room wall"
#
# kiosk-gate.py appends it to the redirect as a URL FRAGMENT (#dt=...), so it never reaches a
# server access log, and the bundle scrubs it out of the address bar on first paint. It is
# deliberately NOT served by homeserver with the HTML: anything on the LAN can fetch that HTML,
# and a wall credential handed to a guest phone is exactly what docs/api.md refuses when it
# forbids an IP allowlist.
#
# Empty is a supported state, and it is visible rather than silent: the wall renders the
# offline card instead of a login form.
WALL_DEVICE_TOKEN=

# Loopback port for kiosk-gate.py, the local origin Chromium actually loads.
# Do not change the bind address away from 127.0.0.1 — this is a kid-facing wall
# and the gate is not meant to be a LAN service.
KIOSK_GATE_PORT=18765

# Loopback DevTools port for kiosk-liveness.sh. kiosk-run.sh also pins
# --remote-debugging-address=127.0.0.1; do not change that. A LAN bind
# would let anyone on the network drive the wall session via CDP.
KIOSK_DEVTOOLS_PORT=9222

# UI scale for the wall. 2.0 renders 1920x1080 as if it were 960x540 CSS pixels, which is the
# viewport the whole design system is built against (web/src/design/README.md: "you design
# against 960x540 logical px"). Changing this number invalidates every tap-target and type
# floor in that document, so treat it as part of the design contract rather than a preference.
# Tune against a real `grim` capture, not a laptop.
KIOSK_SCALE=2.0

# When the wall is lit. screen-power.timer reconciles every minute: on from SCREEN_ON_AT, off
# at SCREEN_OFF_AT (24h HH:MM, local time; a pair that wraps midnight works). At night a touch
# wakes it, and it goes dark again after five idle minutes. A malformed value keeps the screen
# ON — a typo must never dark the wall. Changes apply within a minute; nothing to restart.
SCREEN_ON_AT=06:00
SCREEN_OFF_AT=21:00
